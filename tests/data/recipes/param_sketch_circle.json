{
  "name": "param_sketch_circle",
  "steps": [
    {"tool": "new_part", "args": {}, "assert": {"ok": true}},
    {"tool": "start_sketch", "args": {"plane": "Front Plane"}, "assert": {"ok": true}},
    {"tool": "sketch_circle", "args": {"cx": 0, "cy": 0, "r": 10}, "assert": {"ok": true}},
    {
      "tool": "add_sketch_dimension",
      "args": {"entity1": 0, "value": 40},
      "assert": {"ok": true}
    },
    {"tool": "end_sketch", "args": {}, "assert": {"ok": true}},
    {"tool": "extrude", "args": {"depth": 10}, "assert": {"ok": true, "result_keys": ["name"]}},
    {
      "tool": "set_dimension",
      "args": {"name": "D1@Sketch1", "value": 20},
      "assert": {"ok": true}
    },
    {
      "tool": "get_mass_properties",
      "args": {},
      "assert": {"ok": true, "result_keys": ["volume"]}
    }
  ]
}
